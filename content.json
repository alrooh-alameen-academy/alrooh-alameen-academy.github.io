  "phrases": [
    {
      "text": "أنت البناء لهذه الأمة، ومن كان بناءً عليه ألا يستريح.",
      "emoji": "🏛️"
    },
    {
      "text": "بدايته تعب ونهايته فوز.",
      "emoji": "🌱"
    },
    {
      "text": "أنتم حملة الراية، والراية لا تحملها اليد الضعيفة.",
      "emoji": "🏳️"
    },
    {
      "text": "إن عزمت فبادر، وإن هممت فثابر.",
      "emoji": "🔥"
    },
    {
      "text": "القرآن كالصاحب، كلما طالت الصحبة عرفت أسراره.",
      "emoji": "📖"
    },
    {
      "text": "تمضي الحياة وأنت تطلب أُنسها... والأُنس كل الأُنسِ بالقرءان",
      "emoji": "🤍"
    },
    {
      "text": "اقرأ وارتقِ، فإن منزلتك عند آخر آية تقرؤها.",
      "emoji": "⬆️"
    },
    {
      "text": "إذا بعثرتك الحياة فرتّبها بالقرآن.",
      "emoji": "🧩"
    },
    {
      "text": "كل القلوب التي احتوت القرآن أزهرت.",
      "emoji": "💐"
    },
    {
      "text": "لن تذبل روح صار لها القرآن سقيًا.",
      "emoji": "✨💧"
    }
  ],
